# Puertos / broker MQTT
PORT=3000
# Broker MQTT al que se conecta el ESP32
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_FALL=vigilmotion/+/fall
MQTT_TOPIC_STATUS=vigilmotion/+/status

# URL publica donde corre este backend (para ver notificaciones en el movil,
# usa algo como ngrok). El backend la recuerda para enlazar en la push.
PUBLIC_BASE_URL=http://localhost:3000